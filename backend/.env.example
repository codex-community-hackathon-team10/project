# Application
NODE_ENV=development
PORT=3000

# PostgreSQL started by `docker compose up -d`.
# Replace the credentials and host in deployed environments.
DATABASE_URL=postgres://lunch_mate:lunch_mate_dev@localhost:5432/lunch_mate

# Supabase Auth
# Project URL example: https://your-project-ref.supabase.co
SUPABASE_URL=

# Paste the Publishable key (sb_publishable_...) here.
# Never use a Secret key or service_role key for this value.
SUPABASE_ANON_KEY=
