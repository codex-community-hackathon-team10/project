# 통합 Docker 환경에서는 비워 두면 프론트 Nginx가 /api를 백엔드로 전달합니다.
VITE_API_ORIGIN=

# true면 인증 없이 화면·상태를 점검할 수 있는 목업 API를 사용합니다.
VITE_USE_MOCK_API=false

# DemoTokenVerifier를 쓰는 로컬 백엔드 테스트 전용 토큰입니다.
VITE_DEMO_ACCESS_TOKEN=demo:user_a

# Supabase Auth를 사용할 경우 설정합니다. anon key는 브라우저 공개 키입니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
