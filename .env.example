# 통합 Compose의 PostgreSQL 비밀번호입니다. 배포 환경에서 반드시 변경하세요.
POSTGRES_PASSWORD=change-me

# 인증 UI가 실제 Supabase에 연결되기 전까지 목업 API로 데모합니다.
VITE_USE_MOCK_API=false

# 통합 Docker 백엔드의 demo 인증용 토큰입니다. 실제 Supabase 연동 시 비웁니다.
VITE_DEMO_ACCESS_TOKEN=demo:user_a

# 빈 값이면 프론트와 같은 origin의 /api/v1을 사용합니다.
VITE_API_ORIGIN=

# 실제 Supabase 인증을 쓸 경우에만 설정합니다. Secret/service_role 키는 넣지 마세요.
SUPABASE_URL=
SUPABASE_ANON_KEY=
